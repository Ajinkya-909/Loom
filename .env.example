# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loom_db
POSTGRES_PORT=5432

# Application Ports
BACKEND_PORT=4000
FRONTEND_PORT=8080

# Local Gemma via Ollama (used when the local container is running)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b

# Google Gemini API Fallback (used when local Gemma container is inactive)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
