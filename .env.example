# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=loom_db
POSTGRES_PORT=5432

# Application Ports
BACKEND_PORT=4000
FRONTEND_PORT=8080

# Local Gemma 4 via Ollama
# (do NOT set OLLAMA_BASE_URL here when using docker compose; it defaults to http://ollama:11434)
OLLAMA_MODEL=gemma4:e2b
GEMMA_ONLY=true
OLLAMA_TIMEOUT_MS=300000

# Google Gemini API Fallback (used when local Gemma container is inactive)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
