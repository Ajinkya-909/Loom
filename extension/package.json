{
  "name": "contextport-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ContextPort: capture an AI chat into a lossless, shareable context file.",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "dev": "vite build --watch --mode development",
    "build": "node scripts/make-icons.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mock": "node mock-server/server.mjs",
    "zip": "cd dist && zip -r ../contextport-dist.zip ."
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0",
    "@types/chrome": "0.0.287",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
